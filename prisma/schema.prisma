generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum Role { SUPER_ADMIN ADMIN VIEWER CUSTOMER }
enum WebsiteStatus { NO_WEBSITE WEBSITE_FOUND WEBSITE_UNCERTAIN BROKEN_WEBSITE SOCIAL_ONLY DIRECTORY_ONLY }
enum LeadStatus { DISCOVERED VERIFIED QUALIFIED REJECTED DEMO_PENDING DEMO_GENERATED CONTACT_PENDING CONTACTED FOLLOW_UP REPLIED INTERESTED NOT_INTERESTED CUSTOMER LOST DO_NOT_CONTACT }
enum JobStatus { QUEUED RUNNING COMPLETED FAILED }
model User { id String @id @default(uuid()) email String @unique passwordHash String role Role @default(VIEWER) forcePasswordChange Boolean @default(false) failedLogins Int @default(0) lockedUntil DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt auditLogs AuditLog[] sessions Session[] }
model City { id String @id @default(uuid()) name String country String countryCode String state String? latitude Float? longitude Float? timezone String language String @default("ar") currency String @default("USD") active Boolean @default(true) discoveryEnabled Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt businesses Business[] @@unique([name,countryCode]) }
model Niche { id String @id @default(uuid()) name String slug String @unique description String? active Boolean @default(true) priority Int @default(0) scoringRules Json @default("{}") websiteSections Json @default("[]") requiredFields Json @default("[]") optionalFields Json @default("[]") createdAt DateTime @default(now()) updatedAt DateTime @updatedAt businesses Business[] }
model Business { id String @id @default(uuid()) name String legalName String? normalizedName String cityId String nicheId String country String phone String? normalizedPhone String? email String? address String? latitude Float? longitude Float? websiteUrl String? websiteStatus WebsiteStatus @default(WEBSITE_UNCERTAIN) websiteConfidence Int @default(0) websiteCandidates Json @default("[]") googleRating Float? reviewCount Int? photoCount Int? socialScore Int @default(0) businessScore Int @default(0) businessGrade String? sourceProvider String sourceExternalId String? leadStatus LeadStatus @default(DISCOVERED) lastCheckedAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt deletedAt DateTime? city City @relation(fields:[cityId],references:[id]) niche Niche @relation(fields:[nicheId],references:[id]) sources BusinessSource[] @@unique([sourceProvider,sourceExternalId]) @@index([cityId,nicheId,leadStatus]) @@index([normalizedPhone]) }
model BusinessSource { id String @id @default(uuid()) businessId String field String provider String sourceUrl String? checkedAt DateTime @default(now()) value Json business Business @relation(fields:[businessId],references:[id],onDelete:Cascade) @@index([businessId,field]) }
model DiscoveryJob { id String @id @default(uuid()) cityId String nicheId String status JobStatus @default(QUEUED) requestedLimit Int minimumRating Float minimumReviews Int requireNoWebsite Boolean @default(true) provider String createdAt DateTime @default(now()) startedAt DateTime? completedAt DateTime? errorCode String? }
model AuditLog { id String @id @default(uuid()) actorId String? action String targetType String targetId String? requestId String? metadata Json? createdAt DateTime @default(now()) actor User? @relation(fields:[actorId],references:[id]) @@index([createdAt]) }
model Session { id String @id @default(uuid()) userId String tokenHash String @unique expiresAt DateTime createdAt DateTime @default(now()) revokedAt DateTime? user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
